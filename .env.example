# ============================================
# 穿搭发型顾问 - 环境变量配置模板
# 复制为 .env 后填入实际值
# ============================================

# Flask 环境: development | production | testing
FLASK_ENV=production

# 强密钥（生产环境必须修改！）
# 生成命令: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-strong-secret-key-here
JWT_SECRET_KEY=your-strong-jwt-secret-key-here

# Token 过期时间（秒），默认 24 小时
JWT_ACCESS_TOKEN_EXPIRES=86400

# 数据库（SQLite 适合小项目，大流量可改为 PostgreSQL）
# SQLite 示例: sqlite:////var/www/style-advisor/app.db
# PostgreSQL 示例: postgresql://user:pass@localhost/style_advisor
DATABASE_URL=

# 文件存储
STORAGE_DRIVER=local
UPLOAD_FOLDER=/var/www/style-advisor/data/user_uploads
MAX_CONTENT_LENGTH=16777216

# 第三方 AI API（按需填写）
BAIDU_API_KEY=
BAIDU_SECRET_KEY=
ALIYUN_API_KEY=

# Waitress 服务器配置
HOST=127.0.0.1
PORT=5001
THREADS=4
